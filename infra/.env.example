# Copier en infra/.env (jamais commité).

# Clé d'équipe SAFINUM (sbx_...).
SAFINUM_TEAM_KEY=
# URL déclarée à la sandbox : https://<tunnel>/hook/<HOOK_SECRET>   (openssl rand -hex 24)
HOOK_SECRET=
# Secret des sessions du studio   (openssl rand -base64 48)
STUDIO_SECRET=
# Mot de passe des comptes de démonstration du studio (amina, joseph, admin).
SEED_PASSWORD=

# Banque : la sandbox par défaut. Avec le profil « demo » :
#   SAFINUM_BANK_URL=http://demo-bank:8788/api/v1
#   BANK_ALLOWED_HOSTS=demo-bank
#   SAFINUM_TEAM_KEY=sbx_demo_local
# SAFINUM_BANK_URL=https://safinum.cm/api/v1
# BANK_ALLOWED_HOSTS=

# Service voix sans PyTorch (transcodage seul) : TTS_TORCH=0
# TTS_TORCH=1
