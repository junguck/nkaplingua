{
  "name": "nkaplingua",
  "private": true,
  "type": "module",
  "description": "NkapLingua — infrastructure linguistique multicanale pour les services financiers numériques (SAFINUM Innovate Challenge 2026, finale)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:web": "pnpm --filter @nkap/web dev",
    "build:web": "pnpm --filter @nkap/web build",
    "dev:mobile": "pnpm --filter @nkap/mobile start",
    "android": "pnpm --filter @nkap/mobile android",
    "check:bubble": "cd apps/mobile/modules/nkap-bubble/jvm-check && gradle -q compileKotlin"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
