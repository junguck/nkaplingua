{
  "name": "nkaplingua",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @nkap/gateway build && pnpm --filter @nkap/studio build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "seed": "pnpm --filter @nkap/gateway studio:seed",
    "up": "docker compose -f infra/docker-compose.yml up -d --build"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
