{
  "name": "@nkap/middleware",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Middleware SAFINUM v3 : Fastify, catalogue L1 en mémoire alimenté par Mongo puis Redis, pool HTTP chaud vers la banque.",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/main.js --packages=external",
    "seed": "node src/tools/seed.ts",
    "bench": "node bench/run.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nkap/lingua-core": "workspace:*",
    "fastify": "5.4.0",
    "ioredis": "5.6.1",
    "mongodb": "6.17.0",
    "undici": "7.11.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "esbuild": "0.25.5"
  }
}
