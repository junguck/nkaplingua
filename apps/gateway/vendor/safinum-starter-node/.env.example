# Copiez ce fichier en .env, puis collez votre clé d'équipe (sbx_...).
# Ne publiez jamais le fichier .env (il est dans .gitignore).
SAFINUM_TEAM_KEY=

# Port local du middleware.
PORT=8080

# Facultatif : la passerelle envoie déjà l'URL de la banque dans chaque requête
# (bank_api.base_url). Ne sert que si vous appelez la banque hors d'un tour.
SAFINUM_BANK_URL=
