# Clé d'équipe remise par SAFINUM (sbx_...). À coller dans .env, jamais dans le code.
SAFINUM_TEAM_KEY=
SAFINUM_TEAM_ID=
# Numéro qui possède un compte dans le jeu de données de votre équipe.
SAFINUM_PHONE=
# Facultatif : garder la même session entre les tours USSD.
SAFINUM_SESSION_ID=

# API bancaire : la sandbox en production, ou la banque de démonstration en local.
SAFINUM_BANK_URL=https://safinum.cm/api/v1
# SAFINUM_BANK_URL=http://127.0.0.1:8788/api/v1

# Port du middleware (le tunnel pointera ici).
PORT=8080
HOST=127.0.0.1

# Statut de transaction renvoyé : `lifecycle` (défaut, comme le kit officiel : pending/confirmed/cancelled/failed)
# ou `contract` (repli : seulement none/pending).
SAFINUM_STATUS=lifecycle
