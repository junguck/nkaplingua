# Clé d'équipe remise par SAFINUM (sbx_...). À coller dans .env, jamais dans le code.
SAFINUM_TEAM_KEY=sbx_VOTRE_CLE

# API bancaire : la sandbox en production, ou la banque de démonstration en local.
SAFINUM_BANK_URL=https://safinum.cm/api/v1
# SAFINUM_BANK_URL=http://127.0.0.1:8788/api/v1

# Port du middleware (le tunnel pointera ici).
PORT=8080
HOST=127.0.0.1

# Statut de transaction renvoyé : `contract` (défaut, SANDBOX-SAFINUM §8 : seulement none/pending)
# ou `lifecycle` (confirmed/cancelled/failed) — à n'activer qu'après l'avoir vu accepté par la sandbox.
SAFINUM_STATUS=contract
