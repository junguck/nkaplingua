{
  "name": "@nkap/mobile",
  "version": "2.0.0",
  "private": true,
  "description": "Application mobile NkapLingua (Expo) : tableau de bord, assistant au moteur embarqué hors ligne, bulle Android « touche pour comprendre ».",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "export:android": "expo export --platform android --output-dir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@nkap/client": "workspace:*",
    "@nkap/contracts": "workspace:*",
    "@nkap/react": "workspace:*",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-speech": "~58.0.4",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
